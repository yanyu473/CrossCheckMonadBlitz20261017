# Copy to .env in repo root. Never commit real .env or credentials.
MODE=demo
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://localhost:3001
DATA_DIR=./data
MAX_INPUT_CHARS=12000
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_JOBS=2
MAX_QUEUE_SIZE=20
MODEL_TIMEOUT_MS=20000
CACHE_TTL_MS=3600000
CHAIN_TIMEOUT_MS=30000
RECOVERY_INTERVAL_MS=15000

# MODE=live needs two reviewers. The easiest route is one OpenAI-compatible relay
# plus one key: both slots then differ only by model id. Model ids are never guessed
# — leave them empty unless the upstream really serves them.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_A=
MODEL_B=
# Lowest thinking tier first (minimal). If the upstream rejects it, the adapter
# retries with `low`, then drops the field — it never raises the effort silently.
MODEL_REASONING_EFFORT=minimal
# Per-slot override. Reviewers usually do not accept the same tier: one may need
# `low` to answer at all, another may reject an explicit tier outright. Empty
# values fall back to MODEL_REASONING_EFFORT.
MODEL_A_REASONING_EFFORT=
MODEL_B_REASONING_EFFORT=
# chat | responses | auto (auto tries chat, then responses when the route is missing)
MODEL_WIRE_API=auto
# Shown as `provider` in the report.
MODEL_PROVIDER_LABEL=upstream
# Optional. Only needed when the relay host cannot be resolved directly.
MODEL_HTTP_PROXY=
# Ceiling for one HTTP request, separate from MODEL_TIMEOUT_MS (whole job).
# Raise it when the relay buffers instead of streaming: a reflective question
# can legitimately take 12–15 s on a channel that answers facts in 4 s.
MODEL_REQUEST_TIMEOUT_MS=35000
# Optional. Used only when the primary id keeps failing; the report records the
# model that actually answered in returned_model.
MODEL_A_FALLBACK=
MODEL_B_FALLBACK=

# Alternative: two separate vendor accounts (used when MODEL_BASE_URL is empty).
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Integrated chain module reads deployment.json; demo never broadcasts.
CHAIN_ENABLED=false
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
DEPLOYMENT_FILE=./deployment.json
ISSUER_PRIVATE_KEY=

# Legacy B server/deploy tools only (npm run start:legacy / demo:legacy).
# Default A service uses MONAD_RPC_URL and ISSUER_PRIVATE_KEY above.
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
CHAIN_MODE=monad
PRIVATE_KEY=
CONTRACT_ADDRESS=
ISSUER_ADDRESS=
DEPLOYMENT_BLOCK=
BACKEND_ORIGIN=
